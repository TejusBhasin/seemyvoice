{
  "name": "SiteStats",
  "type": "object",
  "properties": {
    "stat_key": {
      "type": "string",
      "description": "Lookup key for the stats record (e.g. 'global')"
    },
    "total_words": {
      "type": "number",
      "default": 0,
      "description": "Running count of words translated across all users"
    },
    "total_visitors": {
      "type": "number",
      "default": 0,
      "description": "Running count of unique visitors"
    }
  },
  "required": [
    "stat_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}